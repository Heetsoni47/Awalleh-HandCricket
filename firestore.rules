rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }

    // Username → uid map, keeps usernames unique
    match /usernames/{name} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && name.matches('^[a-z0-9_]{3,16}$');
      allow update, delete: if false;
    }

    // Player profile + A-to-Z career stats. Each player updates only their own record.
    match /users/{uid} {
      allow read: if signedIn();
      allow create: if signedIn() && request.auth.uid == uid;
      allow update: if signedIn() && request.auth.uid == uid
        && request.resource.data.username == resource.data.username;
      allow delete: if false;
    }

    // Completed match scorecards. Written once by a player of that match, never edited.
    match /matches/{matchId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.auth.uid in request.resource.data.playerUids;
      allow update, delete: if false;
    }

    // Career head-to-head, id = {batterUid}_{bowlerUid}. Written by the batter.
    match /h2h/{pairId} {
      allow read: if signedIn();
      allow create, update: if signedIn() && pairId.split('_')[0] == request.auth.uid;
      allow delete: if false;
    }
  }
}
